{
  "name": "pesafe",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "PeSafe — личная безопасность, Кыргызстан",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "build": "node scripts/build.js",
    "preview:images": "node scripts/preview.js",
    "test": "node --test tests/core.test.js tests/server.test.js tests/retention.test.js tests/calls.test.js tests/countdown-audio.test.js",
    "test:e2e": "playwright test",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": { "@capacitor/core": "8.6.0", "@capacitor/android": "8.6.0", "@capacitor/ios": "8.6.0" },
  "devDependencies": { "@capacitor/cli": "8.6.0", "@playwright/test": "1.58.2" }
}
