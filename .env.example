HOST=127.0.0.1
PORT=8080
# По умолчанию ничего не отправляется. Сервер — для одного пользователя/семьи.
DELIVERY_DRY_RUN=true
# Случайный ключ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELIVERY_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=
# Только согласованные получатели, предварительно нажавшие Start у бота.
TELEGRAM_CHAT_IDS=
# Только для собственного HTTPS backend + установленных Capacitor-приложений:
NATIVE_ORIGINS=
